{
  "mcpServers": {
    "tavall-ai": {
      "command": "python",
      "args": [
        "./scripts/start_agent_task_manager_mcp.py"
      ],
      "env": {
        "AGENT_TASK_MANAGER_CODEX_DOWNSTREAM_CENTRAL_SERVER": "",
        "AGENT_TASK_MANAGER_CODEX_REMOTE_TOOL_EXECUTION_ENABLED": "true",
        "AGENT_TASK_MANAGER_CODEX_MCP_SERVER_BIN_DIR": "",
        "AGENT_TASK_MANAGER_MCP_BASE_URL": "https://docs.tavall.org/tavall-ai",
        "AGENT_TASK_MANAGER_MCP_ENDPOINT": "/mcp",
        "TAVALL_AI_STDIO_PROTOCOL": "auto",
        "TAVALL_AI_STDIO_DISABLE_DB": ""
      }
    }
  }
}

