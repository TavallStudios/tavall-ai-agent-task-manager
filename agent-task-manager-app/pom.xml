<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.agenttaskmanager</groupId>
    <artifactId>agent-task-manager-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>agent-task-manager-app</artifactId>
  <name>AgentTaskManager App</name>

  <dependencies>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-mcp-http</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-clean-java-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-clean-java-harness</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-artifact-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-cache-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-context-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-computer-use-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-orchestration-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-repo-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-validation-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agenttaskmanager</groupId>
      <artifactId>agent-task-manager-vector-memory-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.agenttaskmanager.app.AgentTaskManagerLauncher</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
