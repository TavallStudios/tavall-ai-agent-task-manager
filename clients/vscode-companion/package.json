{
  "name": "agent-task-manager-vscode-companion",
  "displayName": "AgentTaskManager Companion",
  "version": "0.1.0",
  "publisher": "agenttaskmanager",
  "engines": {
    "vscode": "^1.98.0"
  },
  "activationEvents": [
    "onCommand:agentTaskManager.signIn",
    "onCommand:agentTaskManager.listSessions",
    "onCommand:agentTaskManager.openSession"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentTaskManager.signIn",
        "title": "AgentTaskManager: Sign In"
      },
      {
        "command": "agentTaskManager.listSessions",
        "title": "AgentTaskManager: Refresh Sessions"
      },
      {
        "command": "agentTaskManager.openSession",
        "title": "AgentTaskManager: Open Session"
      },
      {
        "command": "agentTaskManager.submitTurn",
        "title": "AgentTaskManager: Submit Turn"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "agentTaskManager.sessions",
          "name": "AgentTaskManager Sessions"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -p ./ --watch"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.98.0",
    "typescript": "^5.8.2"
  }
}
