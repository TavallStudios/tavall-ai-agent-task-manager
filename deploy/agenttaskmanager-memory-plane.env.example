# Copy to /etc/agenttaskmanager-memory-plane.env on the dev host.
# Keep credentials in the existing root-owned environment files.
AGENT_TASK_MANAGER_QDRANT_BASE_URL=http://127.0.0.1:6333
AGENT_TASK_MANAGER_QDRANT_REQUEST_TIMEOUT=10s
AGENT_TASK_MANAGER_EMBEDDING_PROVIDER_ORDER=local
AGENT_TASK_MANAGER_EMBEDDING_DIMENSIONS=384
AGENT_TASK_MANAGER_LOCAL_EMBEDDING_COMMAND=python3 /srv/AgentTaskManager/current/scripts/fastembed_embed.py
AGENT_TASK_MANAGER_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AGENT_TASK_MANAGER_LOCAL_EMBEDDING_TIMEOUT_SECONDS=30
AGENT_TASK_MANAGER_MEMORY_SYNC_MANAGED_REPO_BACKFILL_ENABLED=false
AGENT_TASK_MANAGER_KNOWLEDGE_ENABLED=true
AGENT_TASK_MANAGER_KNOWLEDGE_BASE=tavall-org
AGENT_TASK_MANAGER_KNOWLEDGE_PROMPT_RESULT_LIMIT=3
APP_MEMORY_RUNTIME_GRAPHIFY_MCP_ENDPOINT=http://127.0.0.1:18999/mcp
APP_MEMORY_RUNTIME_GRAPHITI_MCP_ENDPOINT=http://127.0.0.1:8000/mcp
APP_MEMORY_RUNTIME_GRAPHITI_GROUP_ID=tavall
APP_MEMORY_RUNTIME_EXTERNAL_PROVIDER_TIMEOUT=10s
APP_MEMORY_RUNTIME_EXTERNAL_CONTEXT_LIMIT=6
APP_MEMORY_RUNTIME_GRAPHIFY_DEPTH=3
APP_MEMORY_RUNTIME_GRAPHIFY_TOKEN_BUDGET=500
