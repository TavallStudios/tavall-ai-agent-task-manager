[Unit]
Description=Tavall Graphify memory-plane MCP sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/workspace/tavall-ai-agent-task-manager
ExecStart=/home/ubuntu/.local/bin/graphify-mcp /srv/workspace/tavall-ai-agent-task-manager/graphify-out/graph.json --transport http --host 127.0.0.1 --port 18999 --json-response --stateless
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
