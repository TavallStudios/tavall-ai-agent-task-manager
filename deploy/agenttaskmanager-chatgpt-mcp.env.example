# Opt-in ChatGPT Cloud MCP ingress for the existing AgentTaskManager process.
# The service template also loads the existing Tavall Cloud ChatGPT environment
# for CONTROL identity paths; do not place secret values in this file.
AGENT_TASK_MANAGER_CHATGPT_MCP_GATEWAY_ENABLED=false
AGENT_TASK_MANAGER_CHATGPT_MCP_SOCKET_PATH=/run/tavall-cloud/agent-task-manager-mcp.sock
AGENT_TASK_MANAGER_CHATGPT_MCP_SOCKET_GROUP=tavall-cloud
