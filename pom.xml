<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.2</version>
    <relativePath/>
  </parent>

  <groupId>io.agenttaskmanager</groupId>
  <artifactId>agent-task-manager-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>AgentTaskManager</name>
  <description>Spring Boot control plane for cross-project agent tasks and prompt requests.</description>

  <modules>
    <module>agent-task-manager-core</module>
    <module>spring-webview</module>
    <module>agent-task-manager-clean-java-mcp</module>
    <module>agent-task-manager-clean-java-harness</module>
    <module>agent-task-manager-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.4.1</archunit.version>
    <google.genai.version>1.38.0</google.genai.version>
    <mcp.sdk.version>1.0.0</mcp.sdk.version>
    <mongodb.driver.version>5.2.1</mongodb.driver.version>
    <spoon.version>11.2.1</spoon.version>
  </properties>
</project>
