<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tavall.ai</groupId>
    <artifactId>tavall-ai-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>tavall-ai-app</artifactId>
  <name>Tavall AI App</name>

  <dependencies>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-mcp-http</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-clean-java-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-clean-java-harness</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-artifact-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-cache-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-context-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-computer-use-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-orchestration-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-repo-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-validation-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tavall.ai</groupId>
      <artifactId>tavall-ai-vector-memory-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.tavall.ai.app.Tavall AILauncher</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>




