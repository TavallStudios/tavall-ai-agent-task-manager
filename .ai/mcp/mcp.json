{
  "mcpServers": {
    "chrome-devtools-local": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--executablePath=C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"
      ]
    }
  }
}
